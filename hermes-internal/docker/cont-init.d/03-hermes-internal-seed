#!/command/with-contenv sh
# shellcheck shell=sh
# Seed this deployment's config-as-code onto the HERMES_HOME volume at boot.
#
# /etc/cont-init.d/* run as root in lexicographic order on the s6 PID-1 path.
# This `03-` prefix runs AFTER the upstream init (which seeds defaults + chowns
# the volume), so our files win. On non-PID-1 platforms cont-init may be
# skipped; scripts/entrypoint.sh re-runs the same seed there and hard-fails if
# the config did not take (see UNVERIFIED #3).
#
# The actual work lives in the shared, idempotent seed.sh so both paths behave
# identically.
set -eu
exec /opt/hermes-internal/scripts/seed.sh
