# Copy to .env and fill in. NEVER commit the real .env (see .gitignore).
# On Railway, set these as service Variables instead of shipping a file.
#
# Only variables actually read by this deployment's config.yaml and scripts are
# listed. Each is annotated required/optional.

# --- Model (REQUIRED) -----------------------------------------------------
# Referenced by config.yaml: model.default / model.provider (${env:...}).
# UNVERIFIED: exact working (id, provider) pair — validate with a real key (env B).
HERMES_MODEL=                 # e.g. anthropic/claude-3.5-sonnet  (provider-specific id)
HERMES_MODEL_PROVIDER=        # e.g. openrouter | nous | anthropic | auto

# --- Provider API key (REQUIRED — set the ONE matching HERMES_MODEL_PROVIDER) --
# Read by the provider plugin, not by config.yaml. Set only the relevant one.
# See docs/hermes-facts.md §11 for the full provider→env-var table.
#OPENROUTER_API_KEY=
#NOUS_API_KEY=
#ANTHROPIC_API_KEY=
#GEMINI_API_KEY=

# --- Outbound webhook notification (OPTIONAL) -----------------------------
# Only needed if you uncomment the hooks.outbound block in config.yaml.
#HERMES_OUTBOUND_WEBHOOK_URL=
#HERMES_OUTBOUND_WEBHOOK_SECRET=

# --- Daily health-check cron (OPTIONAL — read by scripts/register-cron.sh) --
#HEALTHCHECK_SCHEDULE=0 9 * * *
#HEALTHCHECK_DELIVER=local

# --- Docker UID/GID remap (OPTIONAL — Docker/local only) ------------------
#HERMES_UID=10000
#HERMES_GID=10000

# NOTE: do NOT set HERMES_HOME — the image fixes it to /opt/data (the volume).
